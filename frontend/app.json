{
  "expo": {
    "name": "AquaPrana",
    "slug": "srihitha",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "CFBundleDisplayName": "AquaPrana",
        "NSBluetoothAlwaysUsageDescription": "AquaPrana uses Bluetooth to connect to nearby water-quality pH meters.",
        "NSBluetoothPeripheralUsageDescription": "AquaPrana uses Bluetooth to connect to nearby water-quality pH meters.",
        "NSLocationWhenInUseUsageDescription": "Location access is required on Android/iOS to scan for nearby Bluetooth sensors."
      }
    },
    "android": {
      "label": "AquaPrana",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.frontend",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAcVxmoyP0CLamYmyy9W5ulLXvISK0Cwkc"
        }
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0D9488",
          "defaultChannel": "weather-general"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F4EF",
          "image": "./assets/images/icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "android": {
            "image": "./assets/images/icon.png",
            "imageWidth": 240
          }
        }
      ],
      [
        "@howincodes/expo-dynamic-app-icon",
        {
          "light": {
            "ios": "./assets/images/icon.png",
            "android": {
              "foregroundImage": "./assets/images/android-icon-foreground.png",
              "backgroundColor": "#000000"
            }
          },
          "dark": {
            "ios": "./assets/images/icon.png",
            "android": {
              "foregroundImage": "./assets/images/android-icon-foreground.png",
              "backgroundColor": "#000000"
            }
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AquaPrana to access your photos to upload aquaculture records.",
          "cameraPermission": "Allow AquaPrana to access your camera to capture aquaculture records."
        }
      ],
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow AquaPrana to record voice notes for Ask Prana."
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": ["peripheral", "central"],
          "bluetoothAlwaysPermission": "AquaPrana uses Bluetooth to connect to nearby water-quality pH meters.",
          "neverForLocation": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2dd98dc5-9c26-4f74-bf40-d34c39f63069"
      }
    },
    "owner": "srihithayerubantis-team"
  }
}
